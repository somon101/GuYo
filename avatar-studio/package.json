{
  "name": "avatar-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Студия аватаров: отдельная офлайн-программа для сборки аватарок из деталей. Не зависит от приложения и сервера GuYo.",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test test/core.test.js",
    "smoke": "node test/smoke.js",
    "start": "electron .",
    "dist:win": "electron-builder --win portable --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "build": {
    "appId": "app.avatarstudio.desktop",
    "productName": "Студия аватаров",
    "files": ["electron/**", "www/**"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "artifactName": "Avatar-Studio.exe" }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.0",
    "@capacitor/core": "^7.6.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "electron": "^38.8.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.47.0"
  }
}
