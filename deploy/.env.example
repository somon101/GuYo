# Copy to deploy/.env and fill in (deploy/setup-server.sh does it for you with random secrets).
# NEVER commit deploy/.env: it holds the passwords.

# The address of the backend (a domain that points to this server), without https://
API_DOMAIN=api.example.com

# The database password (any long random string) and the secret that signs sign-in tokens.
DB_PASSWORD=change-me
JWT_SECRET=change-me-too

# The first admin of the admin panel (created once, on the first start). Change the password at once.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=change-me-now

# Where the admin panel is opened from (GitHub Pages), comma-separated, no slash at the end.
ALLOWED_ORIGINS=https://somon101.github.io

# One worker for a 1 GB server; 2 for 2 GB and more.
WEB_CONCURRENCY=1

# The oldest app build still allowed to answer exercises (0 = no check).
MIN_APP_BUILD=0

# Optional. Empty = off.
SENTRY_DSN=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Sign in with Google (the Web client ID of the app; empty = off). The default one is the project's own.
GOOGLE_CLIENT_IDS=656681360823-dihp65s7tiq23v3gcbtpcfdhnfs95s77.apps.googleusercontent.com
